# Data (root-anchored, so src/gfm4agri/data/ is unaffected)
/data/*
!/data/README.md

# Results, except the proposal-phase EDA which is kept as a record
/results/*
!/results/eda/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Large / binary artefacts
*.npz
*.tif
*.tiff
*.zip
*.pth
*.ckpt
*.safetensors

# Credentials
.env
*.json.key
service_account*.json

# OS / Office
Thumbs.db
desktop.ini
~$*
.DS_Store

# Claude Code / AI tooling (CLAUDE.md itself is kept, it documents the project).
# .claude/settings.json IS tracked: it holds the shared, project-level tool
# permissions and should travel with the repository. Only the per-machine
# override file stays local.
.claude.json
.claude.json.backup
**/.claude/settings.local.json
.anthropic/
.mcp.json
.aider*
.cursor/
.windsurf/
.github/copilot-instructions.md

# Experiments scratch space (runs, checkpoints, logs, ad-hoc outputs)
/experiments/



